# Copy this file to .env and fill in real values before deploying.
# Locally, python-dotenv is NOT required - app.py works fine with just
# environment variables or the defaults in app/config.py.

# A long, random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-something-random

# The email that should always be admin, no matter who registers first.
# Leave blank to just make the FIRST person who ever registers the admin.
ADMIN_EMAIL=

# Where the SQLite file lives. The default (career_planner.db, next to app.py)
# is fine for a single-container deployment with a persistent volume.
DATABASE_PATH=/data/career_planner.db
